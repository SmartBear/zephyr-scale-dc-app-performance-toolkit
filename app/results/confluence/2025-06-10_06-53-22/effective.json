  {
   "module": "final-stats"
  },
  {
   "module": "console"
  },
  {
   "data-source": "sample-labels",
   "module": "junit-xml",
   "filename": "/dc-app-performance-toolkit/app/results/confluence/2025-06-10_06-53-22/xunit.xml"
  },
  {
   "module": "passfail",
   "criteria": [
    {
     "subject": "failures",
     "condition": ">",
     "threshold": "25%",
     "logic": "over",
     "timeframe": "300s",
     "label": "",
     "stop": true,
     "fail": true,
     "message": null
    }
   ]
  }
 ],
 "services": [
  {
   "module": "monitoring",
   "local": [
    {
     "metrics": [
      "cpu",
      "mem",
      "bytes-sent",
      "bytes-recv",
      "disk-read",
      "disk-write",
      "disk-space",
      "engine-loop",
      "conn-all"
     ]
    }
   ]
  },
  {
   "module": "shellexec",
   "prepare": [
    {
     "command": "python util/pre_run/environment_checker.py"
    },
    {
     "command": "python util/pre_run/environment_compliance_check.py confluence"
    },
    {
     "command": "python util/data_preparation/confluence_prepare_data.py"
    }
   ],
   "shutdown": [
